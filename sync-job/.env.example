# Zelfde database als de backend gebruikt (zie ../backend/src/main/resources/application.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pokepack

# Optioneel: API-key via https://dev.pokemontcg.io/ voor hogere rate limits.
# Zonder key: 1000 requests/dag, 30/min — prima voor een periodieke sync van een paar sets.
POKEMON_TCG_API_KEY=
